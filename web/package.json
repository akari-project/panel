{
  "name": "panel-web",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-sdk.mjs",
    "gen:check": "node scripts/gen-sdk.mjs --check",
    "sync-openapi": "node scripts/sync-openapi.mjs",
    "mock": "node mock/start.mjs",
    "dev:portal": "pnpm --filter @panel/portal dev",
    "dev:admin": "pnpm --filter @panel/admin dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm gen:check && pnpm lint:terms && pnpm lint:root && pnpm typecheck:root && pnpm test:root && pnpm -r lint && pnpm -r typecheck && pnpm -r test && pnpm -r build",
    "e2e": "playwright test",
    "lint:terms": "node scripts/check-terms.mjs",
    "lint:root": "eslint mock scripts e2e tooling playwright.config.ts eslint.config.js",
    "typecheck:root": "tsc -p tsconfig.json",
    "test:root": "node --test 'scripts/*.test.mjs'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@stoplight/prism-cli": "^5.16.0",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  }
}
